{
  "resource_group_name": "sftp",
  "location": "Australia East",
  "storage_account_name": "stsftpdemo0721",
  "containers": ["inbound", "outbound"],
  "sftp_users": {
    "inbound": {
      "sequence_number": 0,
      "container": "inbound",
      "ssh_key": "ssh-rsa  sftp-inbound-user",
      "home_rights": "-wx"
    },
    "outbound": {
      "sequence_number": 1,
      "container": "outbound",
      "ssh_key": "ssh-rsa  sftp-outbound-user",
      "home_rights": "r-x"
    }
  }
}
